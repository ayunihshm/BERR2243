		{
			"name": "Post recipe",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"chefId\": \"6843046bc634c9da81b60aea\",\r\n  \"title\": \"Creamy Garlic Mushroom Pasta\",\r\n  \"desc\": {\r\n    \"ingredients\": [\r\n      \"200g fettuccine or spaghetti\",\r\n      \"250g mushrooms, sliced\",\r\n      \"3 cloves garlic, minced\",\r\n      \"1 small onion, finely chopped\",\r\n      \"1 tbsp butter\",\r\n      \"1 tbsp olive oil\",\r\n      \"200ml heavy cream\",\r\n      \"50g grated Parmesan cheese\",\r\n      \"Salt and black pepper to taste\",\r\n      \"Fresh parsley for garnish\"\r\n    ],\r\n    \"steps\": [\r\n      \"Cook pasta according to package instructions. Drain and set aside.\",\r\n      \"In a pan, heat butter and olive oil over medium heat.\",\r\n      \"Sauté onion and garlic until fragrant.\",\r\n      \"Add mushrooms and cook until soft and lightly browned.\",\r\n      \"Pour in the cream and bring to a simmer.\",\r\n      \"Stir in Parmesan cheese, then season with salt and pepper.\",\r\n      \"Add cooked pasta and toss to coat evenly with sauce.\",\r\n      \"Garnish with chopped parsley and serve warm.\"\r\n    ]\r\n  },\r\n  \"status\": \"approved\"\r\n}\r\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:3200/recipes",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "3200",
					"path": [
						"recipes"
					]
				}
			},
			"response": []
		},
